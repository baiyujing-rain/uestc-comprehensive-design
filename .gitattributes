# 统一换行：文本按 LF 入库，Windows 脚本保持 CRLF
* text=auto

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf

# 二进制文件不做换行转换
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.exe   binary
*.so    binary
*.png   binary
*.jpg   binary
*.bmp   binary
*.gds   binary
*.db    binary
*.zip   binary
