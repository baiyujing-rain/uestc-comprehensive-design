digraph "expr_optimization_test" {
  rankdir=LR;
  graph [fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  "a" [shape=oval];
  "b" [shape=oval];
  "c" [shape=oval];
  "y" [shape=doublecircle];
  "w_keep_a" [shape=ellipse];
  "a" -> "w_keep_a";
  "w_keep_c" [shape=ellipse];
  "c" -> "w_keep_c";
  "w_invert_a" [shape=ellipse];
  "gate$1" [shape=box,label="NOT"];
  "a" -> "gate$1";
  "gate$1" -> "w_invert_a";
  "w_final" [shape=ellipse];
  "gate$2" [shape=box,label="AND"];
  "w_keep_a" -> "gate$2";
  "w_keep_c" -> "gate$2";
  "gate$3" [shape=box,label="OR"];
  "gate$2" -> "gate$3";
  "w_invert_a" -> "gate$3";
  "gate$3" -> "w_final";
  "w_final" -> "y";
}
