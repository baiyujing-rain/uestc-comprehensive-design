digraph "test" {
  rankdir=LR;
  graph [fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  "s" [shape=oval];
  "a" [shape=oval];
  "b" [shape=oval];
  "y" [shape=doublecircle];
  "mux_out" [shape=ellipse];
  "gate$1" [shape=box,label="MUX"];
  "s" -> "gate$1" [label="S"];
  "a" -> "gate$1" [label="1"];
  "a" -> "gate$1" [label="0"];
  "gate$1" -> "mux_out";
  "expr_out" [shape=ellipse];
  "const$1" [shape=plaintext,label="1'b1"];
  "gate$2" [shape=box,label="AND"];
  "b" -> "gate$2";
  "const$1" -> "gate$2";
  "const$2" [shape=plaintext,label="1'b0"];
  "gate$3" [shape=box,label="OR"];
  "gate$2" -> "gate$3";
  "const$2" -> "gate$3";
  "gate$3" -> "expr_out";
  "rewrite_out" [shape=ellipse];
  "gate$4" [shape=box,label="AND"];
  "a" -> "gate$4";
  "b" -> "gate$4";
  "gate$5" [shape=box,label="OR"];
  "a" -> "gate$5";
  "gate$4" -> "gate$5";
  "gate$5" -> "rewrite_out";
  "gate$6" [shape=box,label="XOR"];
  "mux_out" -> "gate$6";
  "expr_out" -> "gate$6";
  "gate$7" [shape=box,label="XOR"];
  "gate$6" -> "gate$7";
  "rewrite_out" -> "gate$7";
  "gate$7" -> "y";
}
