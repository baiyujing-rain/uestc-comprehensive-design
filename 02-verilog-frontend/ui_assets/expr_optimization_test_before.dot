digraph "expr_optimization_test" {
  rankdir=LR;
  graph [fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  "a" [shape=oval];
  "b" [shape=oval];
  "c" [shape=oval];
  "y" [shape=doublecircle];
  "w_keep_a" [shape=ellipse];
  "const$1" [shape=plaintext,label="1'b1"];
  "gate$1" [shape=box,label="AND"];
  "a" -> "gate$1";
  "const$1" -> "gate$1";
  "const$2" [shape=plaintext,label="1'b0"];
  "gate$2" [shape=box,label="OR"];
  "gate$1" -> "gate$2";
  "const$2" -> "gate$2";
  "gate$2" -> "w_keep_a";
  "w_keep_c" [shape=ellipse];
  "gate$3" [shape=box,label="XOR"];
  "b" -> "gate$3";
  "b" -> "gate$3";
  "gate$4" [shape=box,label="AND"];
  "c" -> "gate$4";
  "c" -> "gate$4";
  "gate$5" [shape=box,label="OR"];
  "gate$3" -> "gate$5";
  "gate$4" -> "gate$5";
  "gate$5" -> "w_keep_c";
  "w_invert_a" [shape=ellipse];
  "const$3" [shape=plaintext,label="1'b1"];
  "gate$6" [shape=box,label="XOR"];
  "a" -> "gate$6";
  "const$3" -> "gate$6";
  "gate$6" -> "w_invert_a";
  "w_final" [shape=ellipse];
  "gate$7" [shape=box,label="AND"];
  "w_keep_a" -> "gate$7";
  "w_keep_c" -> "gate$7";
  "gate$8" [shape=box,label="OR"];
  "gate$7" -> "gate$8";
  "w_invert_a" -> "gate$8";
  "gate$8" -> "w_final";
  "w_final" -> "y";
}
