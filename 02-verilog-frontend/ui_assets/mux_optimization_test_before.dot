digraph "mux_optimization_test" {
  rankdir=LR;
  graph [fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  "s" [shape=oval];
  "t" [shape=oval];
  "a" [shape=oval];
  "b" [shape=oval];
  "c" [shape=oval];
  "d" [shape=oval];
  "y" [shape=doublecircle];
  "same_mux" [shape=ellipse];
  "gate$1" [shape=box,label="MUX"];
  "s" -> "gate$1" [label="S"];
  "a" -> "gate$1" [label="1"];
  "a" -> "gate$1" [label="0"];
  "gate$1" -> "same_mux";
  "const_mux" [shape=ellipse];
  "const$1" [shape=plaintext,label="1'b0"];
  "gate$2" [shape=box,label="MUX"];
  "const$1" -> "gate$2" [label="S"];
  "b" -> "gate$2" [label="1"];
  "c" -> "gate$2" [label="0"];
  "gate$2" -> "const_mux";
  "bool_mux" [shape=ellipse];
  "const$2" [shape=plaintext,label="1'b1"];
  "const$3" [shape=plaintext,label="1'b0"];
  "gate$3" [shape=box,label="MUX"];
  "t" -> "gate$3" [label="S"];
  "const$2" -> "gate$3" [label="1"];
  "const$3" -> "gate$3" [label="0"];
  "gate$3" -> "bool_mux";
  "nested_mux" [shape=ellipse];
  "gate$4" [shape=box,label="MUX"];
  "s" -> "gate$4" [label="S"];
  "a" -> "gate$4" [label="1"];
  "b" -> "gate$4" [label="0"];
  "gate$5" [shape=box,label="MUX"];
  "s" -> "gate$5" [label="S"];
  "c" -> "gate$5" [label="1"];
  "d" -> "gate$5" [label="0"];
  "gate$6" [shape=box,label="MUX"];
  "s" -> "gate$6" [label="S"];
  "gate$4" -> "gate$6" [label="1"];
  "gate$5" -> "gate$6" [label="0"];
  "gate$6" -> "nested_mux";
  "gate$7" [shape=box,label="XOR"];
  "nested_mux" -> "gate$7";
  "same_mux" -> "gate$7";
  "gate$8" [shape=box,label="XOR"];
  "gate$7" -> "gate$8";
  "const_mux" -> "gate$8";
  "gate$9" [shape=box,label="XOR"];
  "gate$8" -> "gate$9";
  "bool_mux" -> "gate$9";
  "gate$9" -> "y";
}
